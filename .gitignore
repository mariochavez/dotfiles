nvim/.config/nvim/lazyvim.json
tmux/.config/tmux/plugins
zsh/.zsh/zsh-autosuggestions/
zsh/.zsh/zsh-syntax-highlighting/
.DS_Store
bin/bin/datatui
bin/bin/fragua
bin/bin/hey

# herdr runtime files
herdr/.config/herdr/*.log
herdr/.config/herdr/release-notes.json
herdr/.config/herdr/session.json
herdr/.config/herdr/.plugins.lock
herdr/.config/herdr/*.sock
# Installed plugins, their generated config, and the install manifest herdr
# writes alongside them. plugins.json is a cache, not a declaration: it holds
# absolute paths, resolved commit SHAs and install timestamps, so it cannot be
# shared between machines. Reinstall with `herdr plugin install` (see README).
herdr/.config/herdr/plugins/
herdr/.config/herdr/plugins.json

# pi runtime files
# Subagent transcripts and artifacts, written into whatever directory pi runs in.
.pi-subagents/
# The herdr skill is a full clone of the herdr source repo and the impeccable
# skill vendors its own tooling; both are installed per-machine, not shared.
pi/.pi/agent/skills/herdr/
pi/.pi/agent/skills/impeccable/

# editor/app backups
*.bak
