#!/usr/bin/env bash
# toggle_claude — swap the Claude Desktop config between the "local" and
# "remote" MCP profiles kept in this repo.
set -euo pipefail

# Claude Desktop puts its config in a different place on each OS.
case "$OSTYPE" in
  darwin*) CONFIG_DIR="$HOME/Library/Application Support/Claude" ;;
  *)       CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/Claude" ;;
esac

SYMLINK_PATH="$CONFIG_DIR/claude_desktop_config.json"

# The repo is cloned as ~/.dotfiles on some machines and ~/dotfiles on others.
DOTFILES_DIR=""
for candidate in "$HOME/.dotfiles" "$HOME/dotfiles"; do
  if [ -d "$candidate/claude" ]; then
    DOTFILES_DIR="$candidate/claude"
    break
  fi
done

if [ -z "$DOTFILES_DIR" ]; then
  echo "toggle_claude: can't find the dotfiles claude/ directory" >&2
  exit 1
fi

mkdir -p "$CONFIG_DIR"

# Detect current link
current_target="$(readlink "$SYMLINK_PATH" 2>/dev/null || true)"

if [[ "$current_target" == *"local"* ]]; then
  new_target="$DOTFILES_DIR/claude_config.remote.json"
  profile="remote"
else
  new_target="$DOTFILES_DIR/claude_config.local.json"
  profile="local"
fi

# Apply new symlink
rm -f "$SYMLINK_PATH"
ln -s "$new_target" "$SYMLINK_PATH"
echo "🔁 Claude profile switched to: $profile"
